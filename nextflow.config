manifest {
    name    = 'hifi-16s'
    version = 'v1.0'
}

params {
    //  
    custom_config_version = 'master'
    custom_config_base    = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"

    // Pipeline metadata
    version = null
    help = null

    // Required inputs
    input = null
    metadata = null

    // QC / preprocessing
    filterQ = 20
    downsample = 0
    skip_primer_trim = false
    max_ee = 2
    min_len = 500
    max_len = 6000

    // Primer sequences (5' -> 3')
    // Can be either a single string or a list of strings.

    // forward_p = 'AGRGTTYGATYMTGGCTCAG'
    // reverse_p = 'AAGTCGTAACAAGGTARCY'
    
    // 18S
    forward_p = [
    'TTAAAAMGCTCGTAGTYG',
    'TTAAAWCARTTATWRTYT'
    ]

    reverse_p = 'ATTAAACWGTYRGATTCCC'
    
    // Error model learning
    error_model_reads_per_sample = 20
    learn_nbases = null
    error_model = null // "${projectDir}/assets/errorfun.rds" // error model function. If provided, this error model is used.
    binned_quality_scores = '3,10,17,22,27,35,40'

    // Denoising parameters
    band_size = 16
    homopolymer_gap_penalty = 1
    omegac = 1e-40

    // Chimera removal parameters
    chimera_method = 'consensus'
    min_parent_fold = 1.0

    // ASV filtering
    min_asv_total_freq = 10
    min_asv_sample = 0

    // Databases
    db_base_dir = "/home/mk/Downloads/databases/"
    databases_yaml = "${projectDir}/conf/databases.yml"
    db_to_prioritize = 'GG2'

    download_db = false
    download_targets = null

    // Naive Bayes Taxonomy databases (dada2 assignTax)
    nb_databases = ['silva', 'gtdb', 'gg2']

    // VSEARCH taxonomy
    vsearch_databases = ['silva']   // or ['silva', 'gtdb', 'gg2']

    // VSEARCH parameters
    vsearch_identity = 0.97
    maxaccept = 10
    maxreject = 32


    // Output
    outdir = "results"
    publish_dir_mode = "copy"

}

includeConfig 'conf/base.config'

profiles {
    standard {
        conda {
            useMamba = false
            enabled = true
            createTimeout = '2 h'
            cacheDir = env('HOME') + "/nf_conda/"
        }

        params.enable_conda = true
        params.enable_container = false

        docker.enabled = false
        singularity.enabled = false
        podman.enabled = false
        shifter.enabled = false
        charliecloud.enabled = false
    }

    conda {
        conda {
            useMamba = false
            enabled = true
            createTimeout = '2 h'
            cacheDir = env('HOME') + "/nf_conda/"
        }

        params.enable_conda = true
        params.enable_container = false

        docker.enabled = false
        singularity.enabled = false
        podman.enabled = false
        shifter.enabled = false
        charliecloud.enabled = false
    }

    docker {
        docker.enabled = true
        singularity.enabled = false

        params.enable_conda = false
        params.enable_container = true

        podman.enabled = false
        shifter.enabled = false
        charliecloud.enabled = false
    }

    singularity {
        singularity.enabled = true
        singularity.autoMounts = true

        params.enable_conda = false
        params.enable_container = true

        docker.enabled = false
        podman.enabled = false
        shifter.enabled = false
        charliecloud.enabled = false
    }

    test_16s {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_16s.config'
    }

    test_18s {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_18s.config'
    }
}

includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) \
    ? "${params.custom_config_base}/nfcore_custom.config" \
    : "/dev/null"

